# ============================================================================
# Cerium Configuration Environment Variables
# Copy this file to .env for local development:
#     cp .env.example .env
# Never commit .env or share production secrets in version control.
# ============================================================================

# The canonical base address of the site (no trailing slash).
# Local development: http://localhost:3000
# Production: https://ceriumapp.com
BASE_URL=http://localhost:3000
PORT=3000
HOST=127.0.0.1

# Session cryptographic secret (at least 32 random characters).
# Generate a new random secret with: npm run gen-secret
SESSION_SECRET=change-me

# Session lifetime in days (1 to 30, default 7)
SESSION_DAYS=15

# Database location (SQLite file path).
# Default: ./data/cerium.db
DATABASE_PATH=./data/cerium.db

# Admin email addresses allowed to access admin exports and dashboards (comma-separated)
ADMIN_EMAILS=

# Proxy trust count (0 for local, 1 behind reverse proxy like Nginx/Cloudflare/Heroku/Fly.io)
TRUST_PROXY=0

# --- IP INTELLIGENCE (worldwide signup; India INR, all others USD) ---
# Required on production: REGION_ACCESS_MODE=enforce and a valid ipapi.is API key.
# Development defaults off so localhost and private IPs can run without the service.
# For local testing of real network classification, set enforce, a key and use a public IP.
# Never send this token to the browser and never commit an actual key.
REGION_ACCESS_MODE=off
GEOIP_API_KEY=

# --- Authentication: Google Sign-in (OAuth 2.0 PKCE) ---
# Same OAuth client works for all countries.
# Add your real GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET only in your untracked .env.
# The repository's credential scanner rejects real-looking IDs in tracked files.
# Set SESSION_SECRET and any admin emails privately in .env, not in GitHub.
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=paste-your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=paste-your-client-secret-here

# --- Workspace entry gate ---
# All normal runs require the business setup wizard before workspace access.
# phone_and_mandate: require a verified phone, completed business setup and Razorpay authorization
# BEFORE starting the 15-day free trial or allowing workspace access.
# PRODUCTION ONLY ALLOWS phone_and_mandate. No payment card details are stored by CERIUM.
# For LOCAL development without working Razorpay Test Mode, temporarily set phone.
# NEVER use "phone" or "off" in production; it will refuse to start.
# "off" is reserved for NODE_ENV=test automated fixtures, including on localhost.
WORKSPACE_ACCESS_MODE=phone_and_mandate

# --- Phone verification before entering the workspace ---

# Development on localhost: no SMS sent. Use test code 000000 after requesting.
# Production: set PHONE_VERIFY_MODE=twilio and supply Twilio Verify details
# ONLY through private .env or your production secret manager.
# If unavailable, trial and existing subscriptions remain; NEW checkout stays blocked.
PHONE_VERIFY_MODE=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Billing: Razorpay Premium Subscriptions & Checkout ---
# Get API Keys from Razorpay Dashboard (Settings -> API Keys)
# Use rzp_test_... for development / staging, rzp_live_... for production
RAZORPAY_KEY_ID=rzp_test_paste_key_id_here
RAZORPAY_KEY_SECRET=paste_key_secret_here

# Monthly recurring plan ID, created in the Razorpay dashboard (not an API secret).
# Checkout stays disabled until this and valid credentials/webhook secret are configured.
# Optional: dedicated INR 500/month Razorpay subscription plan for the India edition.
# Discounts need separate monthly USD plans; no fallback to the $20 plan.
RAZORPAY_UPPER_MIDDLE_PLAN_ID=
RAZORPAY_LOWER_MIDDLE_PLAN_ID=
RAZORPAY_LOW_PLAN_ID=
RAZORPAY_IN_PLAN_ID=
RAZORPAY_PLAN_ID=plan_paste_monthly_plan_id_here
# OPTIONAL annual Razorpay plans: period=yearly, interval=1, amount=11x monthly tier.
# Missing annual plans DISABLE annual checkout for that specific country tier.
# Confirm local UPI/card recurring mandate support and tax treatment before enabling.
RAZORPAY_ANNUAL_PLAN_ID=
RAZORPAY_ANNUAL_UPPER_MIDDLE_PLAN_ID=
RAZORPAY_ANNUAL_LOWER_MIDDLE_PLAN_ID=
RAZORPAY_ANNUAL_LOW_PLAN_ID=
RAZORPAY_ANNUAL_IN_PLAN_ID=

# Secret used to verify Razorpay webhooks configured at <BASE_URL>/webhooks/razorpay
# Generate with: npm run gen-secret
RAZORPAY_WEBHOOK_SECRET=paste_webhook_secret_here

# Global subscription price is fixed at 2000 cents = $20.00/month.
PRICE_CENTS=2000
# Global default is USD; verified India accounts use the dedicated INR plan.
CURRENCY=USD

# --- Oracle VM automated invoice reminders ---
# Intentionally disabled even if scheduling is active in the UI.
REMINDER_DELIVERY_MODE=disabled
# Only for live mode, with a verified OCI Email Delivery sender:
# The web server also uses this sender for user-requested password reset emails.
REMINDER_SMTP_HOST=
REMINDER_SMTP_PORT=465
REMINDER_SMTP_USER=
REMINDER_SMTP_PASSWORD=
REMINDER_FROM=

# --- Automated Database Backups ---
# Directory to store database snapshots
BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=30

# Cerium Guide: 'navlm' (locally trained, no API calls, default in this example),
# 'guide' (fixed responses), 'ollama' (self-host Qwen 3.5), or 'openai'.
# Qwen is free of per-token API fees, but needs memory and compute on the hosting machine.
CERIUM_AI_PROVIDER=navlm
CERIUM_AI_MODEL=qwen3.5:4b
CERIUM_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Only for CERIUM_AI_PROVIDER=openai, set MODEL=gpt-4.1-mini or another supported model.
# Keep a real OpenAI key only in the untracked .env.
CERIUM_AI_API_KEY=
