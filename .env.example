# ============================================================================
# Cerium Configuration Environment Variables
# Copy this file to .env for local development:
#     cp .env.example .env
# Never commit .env or share production secrets in version control.
# ============================================================================

# The canonical base address of the site (no trailing slash).
# Local development: http://localhost:3000
# Production: https://ceriumapp.com
BASE_URL=http://localhost:3000
PORT=3000
HOST=127.0.0.1

# Session cryptographic secret (at least 32 random characters).
# Generate a new random secret with: npm run gen-secret
SESSION_SECRET=change-me

# Session lifetime in days (1 to 30, default 7)
SESSION_DAYS=7

# Database location (SQLite file path).
# Default: ./data/cerium.db
DATABASE_PATH=./data/cerium.db

# Admin email addresses allowed to access admin exports and dashboards (comma-separated)
ADMIN_EMAILS=

# Proxy trust count (0 for local, 1 behind reverse proxy like Nginx/Cloudflare/Heroku/Fly.io)
TRUST_PROXY=0

# --- GEO RESTRICTIONS (US / India only) ---
# Required on production: REGION_ACCESS_MODE=enforce and a valid ipapi.is API key.
# Development defaults off so localhost and private IPs can run without the service.
# For local testing of real network classification, set enforce, a key and use a public IP.
# Never send this token to the browser and never commit an actual key.
REGION_ACCESS_MODE=off
GEOIP_API_KEY=

# --- Authentication: Google Sign-in (OAuth 2.0 PKCE) ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=paste-your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=paste-your-client-secret-here

# --- Billing: Razorpay Premium Subscriptions & Checkout ---
# Get API Keys from Razorpay Dashboard (Settings -> API Keys)
# Use rzp_test_... for development / staging, rzp_live_... for production
RAZORPAY_KEY_ID=rzp_test_paste_key_id_here
RAZORPAY_KEY_SECRET=paste_key_secret_here

# Monthly recurring plan ID, created in the Razorpay dashboard (not an API secret).
# Checkout stays disabled until this and valid credentials/webhook secret are configured.
# Optional: dedicated INR 500/month Razorpay subscription plan for the India edition.
RAZORPAY_IN_PLAN_ID=
RAZORPAY_PLAN_ID=plan_paste_monthly_plan_id_here

# Secret used to verify Razorpay webhooks configured at <BASE_URL>/webhooks/razorpay
# Generate with: npm run gen-secret
RAZORPAY_WEBHOOK_SECRET=paste_webhook_secret_here

# Subscription pricing settings (amount in smallest currency unit: 2000 cents = $20.00)
PRICE_CENTS=2000
# US-only product configuration: USD pricing. Do not switch to INR.
CURRENCY=USD

# --- Oracle VM automated invoice reminders ---
# Intentionally disabled even if scheduling is active in the UI.
REMINDER_DELIVERY_MODE=disabled
# Only for live mode, with a verified OCI Email Delivery sender:
REMINDER_SMTP_HOST=
REMINDER_SMTP_PORT=465
REMINDER_SMTP_USER=
REMINDER_SMTP_PASSWORD=
REMINDER_FROM=

# --- Automated Database Backups ---
# Directory to store database snapshots
BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=30
