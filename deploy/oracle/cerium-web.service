[Unit]
Description=CERIUM application server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cerium
Group=cerium
WorkingDirectory=/opt/cerium/app
Environment=NODE_ENV=production
EnvironmentFile=/etc/cerium/cerium.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cerium
MemoryMax=420M
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
